# Development Dockerfile - for running the app in Docker with hot reload
FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Copy pom.xml first for dependency caching.
# Use image `mvn` (not mvnw): .dockerignore excludes .mvn/, so the wrapper
# cannot be COPY'd into the build context.
COPY pom.xml .

# Download dependencies (this layer will be cached)
RUN mvn dependency:go-offline -B

# Copy source code
COPY src ./src

# Expose port
EXPOSE 8080

# Only ./src is bind-mounted from the host (see docker-compose.dev.yml).
# /app/target lives inside the container. Maven copies resources into target
# but does not delete removed files — so a deleted migration can linger and
# Flyway then fails with "Found more than one migration with version N".
# Wipe the copied migrations before each run so target matches src.
CMD ["sh", "-c", "rm -rf /app/target/classes/db/migration && mvn spring-boot:run"]
